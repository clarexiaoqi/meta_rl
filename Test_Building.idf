!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:DIAGNOSTICS ===========

!
!
! HVACTemplate:Thermostat,
!     B103 Thermostat,
!     HTGSETP_SCH_NO_OPTIMUM,
!     ,
!     CLGSETP_SCH_NO_OPTIMUM,
!     ;
!
! HVACTemplate:Zone:VAV,
!     Thermal Zone: Space 101,
!     DXVAV Sys 1,
!     B103 Thermostat,
!     autosize,                !- Zone Cooling Design Supply Air Flow Rate {m3/s}
!     1.20,                    !- Zone Heating Sizing Factor
!     1.20,                    !- Zone Cooling Sizing Factor
!     Constant,                !- Zone Minimum Air Flow Input Method
!     0.30,                    !- Zone Minimum Air Flow Fraction
!     ,                        !- Zone Minimum Air Flow Rate {m3/s}
!     ,                        !- Zone Minimum Air Flow Fraction Schedule Name
!     Flow/Person,             !- Outdoor Air Method
!     0.00944,                 !- Outdoor Air Flow Rate per Person {m3/s-person}
!     0.0,                     !- Outdoor Air Flow Rate per Zone Floor Area {m3/s-m2}
!     0.0,                     !- Outdoor Air Flow Rate per Zone {m3/s}
!     Electric,                !- Reheat Coil Type
!     ,                        !- Reheat Coil Availability Schedule Name
!     Normal,                  !- Damper Heating Action; Reverse has no added effect for electric reheat
!     ,                        !- Maximum Flow per Zone Floor Area During Reheat
!     ,                        !- Maximum Flow Fraction During Reheat
!     40.0,                    !- Maximum Reheat Air Temperature {C}; control limit, not autosizable
!     ,                        !- Design Specification Outdoor Air Object Name for Control
!     ,                        !- Supply Plenum Name
!     ,                        !- Return Plenum Name
!     None,                    !- Baseboard Heating Type
!     ,                        !- Baseboard Heating Availability Schedule Name
!     autosize,                !- Baseboard Heating Capacity {W}; ignored for None
!     SystemSupplyAirTemperature, !- Zone Cooling Design SAT Input Method
!     ,                        !- Zone Cooling Design SAT {C}
!     ,                        !- Zone Cooling Design SAT Difference {deltaC}
!     SupplyAirTemperature,    !- Zone Heating Design SAT Input Method
!     40.0,                    !- Zone Heating Design SAT {C}; sizing temperature input, not autosizable
!     ,                        !- Zone Heating Design SAT Difference {deltaC}
!     ,                        !- Design Specification Outdoor Air Object Name for Sizing
!     ;                        !- Design Specification Zone Air Distribution Object Name
!
! HVACTemplate:System:PackagedVAV,
!     DXVAV Sys 1,             !- Name
!     AvailSched_1,            !- System Availability Schedule Name
!     autosize,                !- Supply Fan Maximum Flow Rate {m3/s}
!     autosize,                !- Supply Fan Minimum Flow Rate {m3/s}
!     DrawThrough,             !- Supply Fan Placement
!     0.43,                    !- Supply Fan Total Efficiency
!     1389.42,                 !- Supply Fan Delta Pressure {Pa}
!     0.815,                   !- Supply Fan Motor Efficiency
!     1.0,                     !- Supply Fan Motor in Air Stream Fraction
!     TwoSpeedDX,              !- Cooling Coil Type
!     ,                        !- Cooling Coil Availability Schedule Name
!     FMU_AHU_SAT_Schedule, !- Cooling Coil Setpoint Schedule Name
!     12.8,                    !- Cooling Coil Design Setpoint {C}; control input, not autosizable
!     autosize,                !- Cooling Coil Gross Rated Total Capacity {W}
!     autosize,                !- Cooling Coil Gross Rated Sensible Heat Ratio
!     3.28,                    !- Cooling Coil Gross Rated COP
!     Electric,                !- Heating Coil Type
!     ,                        !- Heating Coil Availability Schedule Name
!     FMU_AHU_SAT_Schedule, !- Heating Coil Setpoint Schedule Name
!     12.8,                    !- Heating Coil Design Setpoint {C}; baseline for single AHU SAT control
!     autosize,                !- Heating Coil Capacity {W}
!     1.0,                     !- Gas Heating Coil Efficiency (ignored for Electric)
!     0.0,                     !- Gas Heating Coil Parasitic Electric Load (ignored)
!     autosize,                !- Maximum Outdoor Air Flow Rate {m3/s}
!     autosize,                !- Minimum Outdoor Air Flow Rate {m3/s}
!     ProportionalMinimum,     !- Minimum Outdoor Air Control Type
!     Min OA Sched,            !- Minimum Outdoor Air Schedule Name
!     DifferentialDryBulb,     !- Economizer Type
!     NoLockout,               !- Economizer Lockout
!     19.0,                    !- Economizer Maximum Limit Dry-Bulb Temperature {C}
!     ,                        !- Economizer Maximum Limit Enthalpy {J/kg}
!     ,                        !- Economizer Maximum Limit Dewpoint Temperature {C}
!     4.0,                     !- Economizer Minimum Limit Dry-Bulb Temperature {C}
!     ,                        !- Supply Plenum Name
!     ,                        !- Return Plenum Name
!     InletVaneDampers,        !- Supply Fan Part-Load Power Coefficients
!     CycleOnAny,              !- Night Cycle Control
!     ,                        !- Night Cycle Control Zone Name
!     None,                    !- Heat Recovery Type
!     0.70,                    !- Sensible Heat Recovery Effectiveness
!     0.65,                    !- Latent Heat Recovery Effectiveness
!     None,                    !- Cooling Coil Setpoint Reset Type (RL-ready; no internal SAT reset)
!     None,                    !- Heating Coil Setpoint Reset Type
!     None,                    !- Dehumidification Control Type
!     ,                        !- Dehumidification Control Zone Name
!     60,                      !- Dehumidification Setpoint {percent}
!     None,                    !- Humidifier Type
!     ,                        !- Humidifier Availability Schedule Name
!     0.000001,                !- Humidifier Rated Capacity {m3/s}
!     2690,                    !- Humidifier Rated Electric Power {W}
!     ,                        !- Humidifier Control Zone Name
!     30,                      !- Humidifier Setpoint {percent}
!     NonCoincident,           !- Sizing Option
!     Yes,                     !- Return Fan
!     0.30,                    !- Return Fan Total Efficiency
!     1389.42,                 !- Return Fan Delta Pressure {Pa}
!     0.85,                    !- Return Fan Motor Efficiency
!     1.0,                     !- Return Fan Motor in Air Stream Fraction
!     InletVaneDampers;        !- Return Fan Part-Load Power Coefficients
Output:Diagnostics,
    DisplayAdvancedReportVariables;  !- Key 1

