    DXVAV Sys 1 Supply Fan Outlet;  !- Component 5 Outlet Node Name


!-   ===========  ALL OBJECTS IN CLASS: BRANCHLIST ===========

BranchList,
    DXVAV Sys 1 Branches,    !- Name
    DXVAV Sys 1 Main Branch; !- Branch 1 Name


!-   ===========  ALL OBJECTS IN CLASS: NODELIST ===========

NodeList,
    DXVAV Sys 1 Mixed Air Nodes,  !- Name
    DXVAV Sys 1 Cooling Coil Outlet,  !- Node 1 Name
    DXVAV Sys 1 Mixed Air Outlet;  !- Node 2 Name


!-   ===========  ALL OBJECTS IN CLASS: OUTDOORAIR:NODELIST ===========

OutdoorAir:NodeList,
    DXVAV Sys 1 Outside Air Inlet;  !- Node or NodeList Name 1


!-   ===========  ALL OBJECTS IN CLASS: EXTERNALINTERFACE ===========

! Two inputs: Python writes one AHU SAT setpoint (used by cooling + central heating) and one zone-air setpoint.
ExternalInterface,
    FunctionalMockupUnitExport;  !- Name of External Interface


!-   ===========  ALL OBJECTS IN CLASS: EXTERNALINTERFACE:FUNCTIONALMOCKUPUNITEXPORT:FROM:VARIABLE ===========

! Outputs: measured response and electrical power.
ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    Thermal Zone: Space 101, !- Output:Variable Index Key Name
    Zone Mean Air Temperature,  !- Output:Variable Name
    T_zone_C;                !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    Environment,             !- Output:Variable Index Key Name
    Site Outdoor Air Drybulb Temperature,  !- Output:Variable Name
    T_outdoor_C;             !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    DXVAV Sys 1 Supply Fan Outlet,  !- Output:Variable Index Key Name
    System Node Temperature, !- Output:Variable Name
    T_ahu_supply_C;          !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    DXVAV Sys 1 Supply Fan Outlet,  !- Output:Variable Index Key Name
    System Node Setpoint Temperature,  !- Output:Variable Name
    ahu_sat_sp_read_C;       !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    DXVAV Sys 1 Cooling Coil,!- Output:Variable Index Key Name
    Cooling Coil Electricity Rate,  !- Output:Variable Name
    P_cooling_W;             !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    DXVAV Sys 1 Heating Coil,!- Output:Variable Index Key Name
    Heating Coil Electricity Rate,  !- Output:Variable Name
    P_ahu_heating_W;         !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    Thermal Zone: Space 101 Reheat Coil,  !- Output:Variable Index Key Name
    Heating Coil Electricity Rate,  !- Output:Variable Name
    P_reheat_W;              !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    DXVAV Sys 1 Supply Fan,  !- Output:Variable Index Key Name
    Fan Electricity Rate,    !- Output:Variable Name
    P_supply_fan_W;          !- FMU Variable Name

ExternalInterface:FunctionalMockupUnitExport:From:Variable,
    DXVAV Sys 1 Return Fan,  !- Output:Variable Index Key Name
    Fan Electricity Rate,    !- Output:Variable Name
    P_return_fan_W;          !- FMU Variable Name


!-   ===========  ALL OBJECTS IN CLASS: EXTERNALINTERFACE:FUNCTIONALMOCKUPUNITEXPORT:TO:SCHEDULE ===========

ExternalInterface:FunctionalMockupUnitExport:To:Schedule,
    FMU_AHU_SAT_Schedule,    !- Schedule Name
    Temperature,             !- Schedule Type Limits Names
    ahu_sat_sp_C,            !- FMU Variable Name
    12.8;                    !- Initial Value

ExternalInterface:FunctionalMockupUnitExport:To:Schedule,
    FMU_Zone_Air_Setpoint_Schedule,  !- Schedule Name
    Temperature,             !- Schedule Type Limits Names
    zone_temp_sp_C,          !- FMU Variable Name
    24;                      !- Initial Value


!-   ===========  ALL OBJECTS IN CLASS: AVAILABILITYMANAGER:NIGHTCYCLE ===========

AvailabilityManager:NightCycle,
    DXVAV Sys 1 Availability,!- Name
    HVACTemplate-Always 1,   !- Applicability Schedule Name
    AvailSched_1,            !- Fan Schedule Name
    CycleOnAny,              !- Control Type
    0.2,                     !- Thermostat Tolerance {deltaC}
    FixedRunTime,            !- Cycling Run Time Control Type
    3600;                    !- Cycling Run Time {s}


!-   ===========  ALL OBJECTS IN CLASS: AVAILABILITYMANAGERASSIGNMENTLIST ===========

AvailabilityManagerAssignmentList,
    DXVAV Sys 1 Availability Managers,  !- Name
    AvailabilityManager:NightCycle,  !- Availability Manager 1 Object Type
    DXVAV Sys 1 Availability;!- Availability Manager 1 Name


!-   ===========  ALL OBJECTS IN CLASS: SETPOINTMANAGER:SCHEDULED ===========

SetpointManager:Scheduled,
    DXVAV Sys 1 Cooling Supply Air Temp Manager,  !- Name
    Temperature,             !- Control Variable
    FMU_AHU_SAT_Schedule,    !- Schedule Name
    DXVAV Sys 1 Supply Fan Outlet;  !- Setpoint Node or NodeList Name

SetpointManager:Scheduled,
    DXVAV Sys 1 Heating Supply Air Temp Manager,  !- Name
    Temperature,             !- Control Variable
    FMU_AHU_SAT_Schedule,    !- Schedule Name
    DXVAV Sys 1 Supply Path Inlet;  !- Setpoint Node or NodeList Name


!-   ===========  ALL OBJECTS IN CLASS: SETPOINTMANAGER:MIXEDAIR ===========

SetpointManager:MixedAir,
    DXVAV Sys 1 Cooling Coil Air Temp Manager,  !- Name
    Temperature,             !- Control Variable
    DXVAV Sys 1 Supply Fan Outlet,  !- Reference Setpoint Node Name
    DXVAV Sys 1 Heating Coil Outlet,  !- Fan Inlet Node Name
    DXVAV Sys 1 Supply Fan Outlet,  !- Fan Outlet Node Name
    DXVAV Sys 1 Mixed Air Nodes;  !- Setpoint Node or NodeList Name

SetpointManager:MixedAir,
    DXVAV Sys 1 Heating Coil Air Temp Manager,  !- Name
    Temperature,             !- Control Variable
    DXVAV Sys 1 Supply Path Inlet,  !- Reference Setpoint Node Name
    DXVAV Sys 1 Heating Coil Outlet,  !- Fan Inlet Node Name
    DXVAV Sys 1 Supply Fan Outlet,  !- Fan Outlet Node Name
    DXVAV Sys 1 Heating Coil Outlet;  !- Setpoint Node or NodeList Name


!-   ===========  ALL OBJECTS IN CLASS: CURVE:QUADRATIC ===========

Curve:Quadratic,
    DXVAV Sys 1 DX Coil PLF, !- Name
    0.85,                    !- Coefficient1 Constant
    0.15,                    !- Coefficient2 x
    0.0,                     !- Coefficient3 x**2
    0.0,                     !- Minimum Value of x
    1.0;                     !- Maximum Value of x


!-   ===========  ALL OBJECTS IN CLASS: CURVE:CUBIC ===========

! DOE-2.1E, SDL-C78
Curve:Cubic,
    DXVAV Sys 1 DX Coil Cap-FF,  !- Name
    0.47278589,              !- Coefficient1 Constant
    1.2433415,               !- Coefficient2 x
    -1.0387055,              !- Coefficient3 x**2
    0.32257813,              !- Coefficient4 x**3
    0.5,                     !- Minimum Value of x
    1.5;                     !- Maximum Value of x

! DOE-2.1E, SDL-C82
Curve:Cubic,
    DXVAV Sys 1 DX Coil EIR-FF,  !- Name
    1.0079484,               !- Coefficient1 Constant
    0.34544129,              !- Coefficient2 x
    -.6922891,               !- Coefficient3 x**2
    0.33889943,              !- Coefficient4 x**3
    0.5,                     !- Minimum Value of x
    1.5;                     !- Maximum Value of x


